{
  "name": "rsi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:mysql": "node scripts/mysql-test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
