{
  "name": "rsi-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "env -u NODE_OPTIONS -u NODE_PATH node ../scripts/backend-command.mjs start",
    "dev": "env -u NODE_OPTIONS -u NODE_PATH node ../scripts/backend-command.mjs dev",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:mysql": "node scripts/mysql-test.mjs",
    "reset:workspace-data": "env -u NODE_OPTIONS -u NODE_PATH node ../scripts/backend-command.mjs reset"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "mysql2": "3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  }
}
