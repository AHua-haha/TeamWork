{
  "version": 2,
  "paths": {
    "stateDirectory": "${HOME}/.local/state/${PROJECT}",
    "developmentStateDirectory": "${PROJECT_ROOT}/.run",
    "deploymentSourceRoot": "/tmp/${PROJECT}-deploy"
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 13306,
    "project": "${PROJECT}",
    "dockerContext": "default",
    "rootPassword": "GENERATED_BY_INIT",
    "image": "mysql:8.4",
    "containerName": "${PROJECT}-mysql",
    "networkName": "${PROJECT}-network",
    "volumeName": "${PROJECT}-mysql-data",
    "networkKey": "database"
  },
  "development": {
    "backendPort": 3100,
    "frontendPort": 5373,
    "database": {
      "name": "team_work_dev",
      "username": "team_work_dev",
      "password": "GENERATED_BY_INIT"
    },
    "encryptionKey": "GENERATED_BY_INIT",
    "environment": {
      "DEEPSEEK_WEB_API_KEY": ""
    },
    "contextCompactionThresholdTokens": 256000
  },
  "deployment": {
    "backendPort": 3101,
    "frontendPort": 5374,
    "database": {
      "name": "team_work",
      "username": "team_work_deploy",
      "password": "GENERATED_BY_INIT"
    },
    "encryptionKey": "GENERATED_BY_INIT",
    "environment": {
      "DEEPSEEK_WEB_API_KEY": ""
    },
    "contextCompactionThresholdTokens": 256000
  }
}
